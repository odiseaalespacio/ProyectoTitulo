# Copie este archivo en la EC2 como /home/ec2-user/cloty.env
# y complete sus datos. NO suba este archivo con contraseñas reales a Git.

SPRING_PROFILES_ACTIVE=aws

SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/cloty?useSSL=false&serverTimezone=UTC&characterEncoding=utf8
SPRING_DATASOURCE_USERNAME=cloty_user
SPRING_DATASOURCE_PASSWORD=Cloty_2026

SPRING_JPA_HIBERNATE_DDL_AUTO=update
SERVER_ADDRESS=0.0.0.0
SERVER_PORT=8080

CLOTY_JWT_SECRET=CAMBIAR_SecretMin32CharsParaHS256_AwsPrueba!!

# --- Correo Gmail (contraseña de aplicación, no la clave normal) ---
CLOTY_MAIL_ENABLED=true
CLOTY_MAIL_FROM=su_correo@gmail.com
SPRING_MAIL_USERNAME=su_correo@gmail.com
SPRING_MAIL_PASSWORD="xxxx xxxx xxxx xxxx"
